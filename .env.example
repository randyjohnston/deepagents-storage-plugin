# deepagents-blob — environment template.
# Copy to .env and fill in what you use; .env is gitignored. Every example
# (run_agent.py, chat.py) auto-loads .env from the project root.

# --- Model (need at least one; MODEL overrides auto-selection) --------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Blob store selection (first match wins; none = in-memory) --------------
# S3-compatible (AWS, GCS interop, Backblaze B2, MinIO, R2):
S3_BUCKET=deepagents-blob-test-dab05148
# S3_ENDPOINT_URL=                # omit for AWS; e.g. http://localhost:9000
# AWS credentials come from your normal AWS config (aws login / ~/.aws),
# or uncomment to pin static keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Google Cloud Storage through S3 interoperability:
#   S3_ENDPOINT_URL=https://storage.googleapis.com
# GCS does NOT accept a service-account key JSON on this endpoint. Create an
# HMAC key pair for the service account and use it as the AWS_* pair above:
#   gcloud storage hmac create SA_EMAIL --project PROJECT
#   AWS_ACCESS_KEY_ID=<accessId, starts with GOOG1E>
#   AWS_SECRET_ACCESS_KEY=<secret>
# boto3 >= 1.36 sends aws-chunked CRC32 trailers that GCS rejects with
# SignatureDoesNotMatch. Both settings below are required for GCS:
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# Box (Client Credentials Grant app, must be authorized in Admin Console):
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# --- CLI ---------------------------------------------------------------------
# DEEPAGENTS_DOWNLOADS_DIR=       # default: ~/Downloads

# Store selector: s3 | box | memory (unset = auto from credentials)
# BLOB_STORE=

# Offload cutoff: files larger than this go to the blob store (bytes, or K/KB/M/MB suffix)
# BLOB_THRESHOLD=512KB
